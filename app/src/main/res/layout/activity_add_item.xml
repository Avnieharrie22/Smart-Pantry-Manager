<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/peach_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->

        <TextView
            android:id="@+id/addItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Pantry Item"
            android:textColor="@color/peach_dark"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keep your pantry organised and up to date."
            android:textColor="@color/peach_secondary_text"
            android:textSize="15sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp" />

        <!-- Ingredient Name -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingredient Name"
            android:textColor="@color/peach_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/ingredientNameInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/edit_text_background"
            android:hint="e.g. Tomato"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/peach_text"
            android:textColorHint="@color/peach_secondary_text"
            android:textSize="16sp"
            android:inputType="textCapSentences" />

        <!-- Quantity -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantity"
            android:textColor="@color/peach_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/quantityInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/edit_text_background"
            android:hint="e.g. 2"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/peach_text"
            android:textColorHint="@color/peach_secondary_text"
            android:textSize="16sp"
            android:inputType="numberDecimal" />

        <!-- Unit -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unit"
            android:textColor="@color/peach_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/unitSpinner"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/spinner_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Expiry Date -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expiry Date"
            android:textColor="@color/peach_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Optional"
            android:textColor="@color/peach_secondary_text"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <EditText
            android:id="@+id/expiryDateInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/edit_text_background"
            android:hint="Select expiry date"
            android:focusable="false"
            android:clickable="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/peach_text"
            android:textColorHint="@color/peach_secondary_text"
            android:textSize="16sp" />

        <!-- Save Button -->

        <Button
            android:id="@+id/saveItemButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Save Item"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/peach_button"
            android:background="@null"
            android:elevation="3dp" />

        <!-- Cancel Button -->

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Cancel"
            android:textColor="@color/peach_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/white"
            android:background="@null"
            android:elevation="2dp" />

    </LinearLayout>

</ScrollView>

